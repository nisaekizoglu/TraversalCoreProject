@model TraversalCoreProject.Areas.Admin.Models.UpdateRoleViewModel
@{
    ViewData["Title"] = "UpdateRole";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Rol Güncelleme Sayfası</h1>

<form method="post">
    @Html.HiddenFor(x=>x.RoleID)
    <div class="form-group">
        @Html.Label("Rol Adı")
        <input type="text" asp-for="RoleName" class="form-control" />
    </div>
    <br />
    <button class="btn btn-outline-success">Rol Güncelle</button>
</form>

