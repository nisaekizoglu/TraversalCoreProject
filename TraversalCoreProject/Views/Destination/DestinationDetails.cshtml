@model EntityLayer.Concrete.Destination
@{
    ViewData["Title"] = "DestinationDetails";
    Layout = "~/Views/Shared/_UILayout.cshtml";
}
<!doctype html>
<html lang="zxx">
<body>

    <!-- about breadcrumb -->
    <section class="w3l-about-breadcrumb text-left">
        <div class="breadcrumb-bg breadcrumb-bg-about py-sm-5 py-4">
            <div class="container">
                <h2 class="title">Tur Detayları</h2>
                <ul class="breadcrumbs-custom-path mt-2">
                    <li><a href="/Default/Index/">Ana Sayfa</a></li>
                    <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span> Rehberin Yorumları </li>
                </ul>
            </div>
        </div>
    </section>
    <!-- //about breadcrumb -->
    <!--/blog-->
    <div class="py-5 w3l-homeblock1 text-center">
        <div class="container mt-md-3">
            <h3 class="blog-desc-big text-center mb-4">
                Seyahat Detayları
            </h3>
            <div class="blog-post-align">
                <div class="blog-post-info">
                </div>
            </div>
        </div>
    </div>

    <section class="blog-post-main w3l-homeblock1">
        <!--/blog-post-->
        <div class="blog-content-inf pb-5">
            <div class="container pb-lg-4">
                <div class="row">
                    <div class="col-lg-10 mx-auto">

                        <!-- Kapak Görseli Bölümü -->
                        <div class="single-post-image text-center">
                            <div class="post-content">
                                <img src="@Model.CoverImage" style="max-width:900px; width:100%; height:500px; object-fit:cover;" class="radius-image img-fluid mb-5 mx-auto d-block" alt="" />
                            </div>
                        </div>

                        <!-- Metin ve Diğer İçerikler (Artık görselle tam aynı hizada başlayacak) -->
                        <div class="single-post-content">
                            <p class="mb-4 text-justify">
                                @Model.Details1
                            </p>

                            <blockquote class="blockquote my-5">
                            </blockquote>

                            <!-- Küçük İkili Görseller -->
                            <div class="sing-post-thumb mb-5 row pt-3">
                                <div class="col-sm-6">
                                    <a href="#url">
                                        <img src="@Model.Image" style="width:100%; height:380px; object-fit:cover;" class="img-fluid radius-image" alt="">
                                    </a>
                                </div>
                                <div class="col-sm-6 mt-sm-0 mt-3">
                                    <a href="#url">
                                        <img src="@Model.Image2" style="width:100%; height:380px; object-fit:cover;" class="img-fluid radius-image" alt="">
                                    </a>
                                </div>
                            </div>

                            <p class="mb-4 text-justify">
                                @Model.Details2
                            </p>

                            <div class="d-grid left-right mt-5 pb-md-5">
                                <div class="buttons-singles tags">
                                    <h4>Tags :</h4>
                                    <a href="#blog-tag">Gezi</a>
                                    <a href="#blog-tag">Kültür</a>
                                    <a href="#blog-tag">Konaklama</a>
                                    <a href="#blog-tag">Eğlence</a>
                                </div>
                                <div class="buttons-singles">
                                    <h4>Share :</h4>
                                    <a href="#blog-share"><span class="fa fa-facebook" aria-hidden="true"></span></a>
                                    <a href="#blog-share"><span class="fa fa-twitter" aria-hidden="true"></span></a>
                                    <a href="#blog-share"><span class="fa fa-google-plus" aria-hidden="true"></span></a>
                                    <a href="#blog-share"><span class="fa fa-pinterest-p" aria-hidden=" true"></span></a>
                                </div>
                            </div>

                            @await Component.InvokeAsync("_GuideDetails", new { id = ViewBag.i })

                            @await Component.InvokeAsync("_CommentList", new { id = ViewBag.i })

                            @await Html.PartialAsync("~/Views/Comment/AddComment.cshtml")

                        </div>

                    </div>
                </div> <!-- Row bitişi -->
            </div>
        </div>
        <!--//blog-post-->
    </section>

    <!-- Template JavaScript -->
    <script src="~/Traversal-Liberty/assets/js/jquery-3.3.1.min.js"></script>
    <script src="~/Traversal-Liberty/assets/js/theme-change.js"></script>
    <script src="~/Traversal-Liberty/assets/js/bootstrap.min.js"></script>
</body>
</html>