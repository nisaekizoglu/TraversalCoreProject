@using EntityLayer.Concrete
@model List<Destination>

<section class="w3l-grids-3 py-5">
    <div class="container py-md-5">
        <div class="title-content text-left mb-lg-5 mb-4">
            <h6 class="sub-title">Seyehatini Planla</h6>
            <h3 class="hny-title">Popülar Tur Rotaları</h3>
        </div>
        <div class="row bottom-ab-grids">
            <!--/row-grids-->
            @foreach (var item in Model)
            {
                <div class="col-lg-6 subject-card mb-4 d-flex align-items-stretch">
                    <!-- 'w-100' ve 'd-flex flex-column' ile iç kartın dış sütunu tamamen kaplamasını sağladık -->
                    <div class="subject-card-header p-4 w-100 d-flex flex-column justify-content-between">
                        <a href="#" class="card_title p-lg-4 d-block h-100">
                            <div class="row align-items-center h-100">
                                <div class="col-sm-5 subject-img">
                                    <img src="@item.Image" class="img-fluid rounded" alt="">
                                </div>
                                <div class="col-sm-7 subject-content mt-sm-0 mt-4">
                                    <h4>@item.City</h4>
                                    <p>@item.DayNight</p>
                                    <div class="dst-btm">
                                        <h6 class=""> Başlayan Fiyatlarla </h6>
                                        <span>$@item.Price</span>
                                    </div>
                                    <p class="sub-para">@item.Description</p>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>